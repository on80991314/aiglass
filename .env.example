# Copy to .env and fill in. The edge loader reads .env at the project root.

# ---- Networking ----
WS_HOST=0.0.0.0
WS_PORT=8765

# ---- YOLO ----
YOLO_WEIGHTS=yolov8n.pt
YOLO_DEVICE=cpu            # "cpu" or "cuda:0"
YOLO_CONF=0.35

# ---- Speech ----
STT_MODEL=tiny             # tiny / base / small / medium / large-v3
STT_LANGUAGE=zh
TTS_BACKEND=pyttsx3        # pyttsx3 (offline) | edge_tts (cloud, better zh-TW)
TTS_VOICE=zh-TW-HsiaoChenNeural

# ---- Cloud APIs ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GMAP_API_KEY=
GMAP_LANGUAGE=zh-TW

# ---- Speech pacing ----
SPEECH_MIN_GAP_S=3.0
SPEECH_REPEAT_GAP_S=7.0

# ---- Emergency notify ----
EMERGENCY_CONTACT=
NOTIFY_TOKEN=
